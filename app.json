{
  "expo": {
    "name": "Yatri",
    "slug": "yatri",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yatri",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.riders.yatri",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E8590C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yatri uses your location to record your route, speed and where you parked.",
          "locationAlwaysAndWhenInUsePermission": "Yatri uses your location while a ride is recording, including when your phone is locked, so your whole route is saved.",
          "motionUsagePermission": "Yatri uses motion sensors to estimate lean angle and G-force.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8590C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yatri uses your photo library so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-asset",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
