{
  "rules": {
    "groups": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('leader').val() === auth.uid",
          ".validate": "newData.hasChildren(['leader', 'createdAt'])",
          "leader": {
            ".write": "auth != null && data.val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "dest": {
            ".write": "auth != null && root.child('groups').child($code).child('meta/leader').val() === auth.uid",
            ".validate": "newData.hasChildren(['lat', 'lng', 'name'])",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "$other": {
              ".validate": false
            }
          },
          "ended": {
            ".write": "auth != null && root.child('groups').child($code).child('meta/leader').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('groups').child($code).child('meta').exists()",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "bike": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "chat": {
          ".read": "auth != null && root.child('groups').child($code).child('members').child(auth.uid).exists()",
          "$msgId": {
            ".write": "auth != null && !data.exists() && root.child('groups').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['uid', 'msg', 't'])",
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "msg": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "nick": {
          ".read": "auth != null && root.child('groups').child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && root.child('groups').child($code).child('members').child(auth.uid).exists() && (!newData.exists() || root.child('groups').child($code).child('members').child($uid).exists())",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
          }
        },
        "look": {
          ".read": "auth != null && root.child('groups').child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && root.child('groups').child($code).child('members').child(auth.uid).exists() && (!newData.exists() || root.child('groups').child($code).child('members').child($uid).exists())",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          }
        },
        "photos": {
          ".read": "auth != null && root.child('groups').child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (!newData.exists() || root.child('groups').child($code).child('members').child(auth.uid).exists())",
            ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 40000"
          }
        },
        "pos": {
          ".read": "auth != null && root.child('groups').child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (!newData.exists() || root.child('groups').child($code).child('members').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['lat', 'lng', 'spd', 't'])",
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "spd": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 400"
            },
            "hdg": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
